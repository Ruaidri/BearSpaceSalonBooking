{
  "name": "bearspacecodetest",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "salon-booking",
    "server"
  ],
  "scripts": {
    "install": "npm install --workspaces",
    "start:frontend": "npm run dev --workspace salon-booking",
    "start:backend": "npm run start --workspace server",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  }
}
